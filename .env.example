# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only key. NEVER expose this in frontend code.
# Use the Supabase service_role key (or set SUPABASE_SECRET_KEY instead).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-safe key. Use anon (or set SUPABASE_PUBLISHABLE_KEY instead).
SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key. Server-only.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: change the bucket name only if you also change it in schema.sql.
SUPABASE_BUCKET=studymind-files
